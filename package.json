{
  "name": "goffnelson",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "node scripts/build-site.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "check": "npm run cms:generate && astro check",
    "content:check": "node scripts/validate-content.mjs",
    "cms:generate": "tinacms build --local --skip-cloud-checks",
    "build:cloud": "tinacms build --content=local -c \"astro build\""
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.3",
    "@tinacms/cli": "^4.0.4",
    "tinacms": "^3.15.0",
    "@types/node": "^25.9.1",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^5.0.5",
    "@astrojs/sitemap": "^3.7.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@playform/compress": "^0.2.3",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.6",
    "flowbite-react": "^0.12.17",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "tailwindcss": "^4.2.4",
    "@astrojs/vercel": "^10.0.8",
    "@tinacms/astro": "^0.8.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
