---
import { tinaField } from '@tinacms/astro/tina-field';
import TrailSign from '../TrailSign.astro';
import { librarySettings } from '../../lib/library-content';
import { safeTelHref, sanitizeImageSrc } from '../../lib/safe-url';
import type { HomeQuery } from '../../../tina/__generated__/types';

interface Props {
  data: HomeQuery['home'];
}

const { data } = Astro.props;
---

{
  data && (
    <>
      <section class="hero" aria-label="Library photograph">
        <img
          class="hero__image"
          src={sanitizeImageSrc(data.heroImage)}
          alt={data.heroAlt ?? ''}
          data-tina-field={tinaField(data, 'heroImage')}
          width="1600"
          height="600"
          fetchpriority="high"
          decoding="async"
        />
        <TrailSign />
      </section>

      <section class="intro" aria-labelledby="intro-heading">
        <h1 id="intro-heading" data-tina-field={tinaField(data, 'headline')}>
          {data.headline}
        </h1>
        <p data-tina-field={tinaField(data, 'introduction')}>{data.introduction}</p>
        <p>
          Visit us at <strong>{librarySettings.address}</strong> or call
          <a href={safeTelHref(librarySettings.phoneLink) || undefined}>{librarySettings.phone}</a>.
        </p>
      </section>
    </>
  )
}
